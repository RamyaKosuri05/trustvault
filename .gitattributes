# Auto detect text files and perform LF normalization on checkout
* text=auto

# Strict Unix line endings for shell scripts and Dockerfile
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaries
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.db binary
*.sqlite binary
*.sqlite3 binary
