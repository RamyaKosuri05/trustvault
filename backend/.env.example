# ============================================================
# TrustVault Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg2://trustvault:trustvault_dev_password@localhost:5432/trustvault

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# --- Application ---
ENVIRONMENT=development
# In production: set to your Vercel frontend URL(s), comma-separated
CORS_ORIGINS=http://localhost:5173

# --- File Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# S3 (optional — set STORAGE_BACKEND=s3 to activate)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=10

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3

# --- Malware Scanner (optional ClamAV) ---
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# --- Demo Seed ---
# NEVER set to true in production — only for judge demo environment
ALLOW_DEMO_SEED=false

# --- Session ---
SESSION_COOKIE_SECURE=false   # Set true in production (HTTPS only)
SESSION_EXPIRE_HOURS=24

